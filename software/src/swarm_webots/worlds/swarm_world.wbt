# Dedicated supervisor robot: no physical body needed, just gives ROS2 the
# ability to teleport the robots above in/out of the arena.
DEF swarm_supervisor Robot {
  name "swarm_supervisor"
  controller "<extern>"
  supervisor TRUE
}
